{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./renderer/*"
      ],
      "@element-plus/icons-vue": [
        "./node_modules/@element-plus/icons-vue/dist/types/index.d.ts"
      ]
    }
  },
  "include": [
    "renderer/**/*.js",
    "renderer/**/*.ts",
    "renderer/**/*.vue",
    "types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "out"
  ]
}
